    .card {
        background: white;
        padding: 25px;
        margin: 15px 0;
        border-radius: 15px;
        box-shadow: 0 4px 15px #173b7012;
    }

    .skills {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .skills span {
        background: #dceaff;
        color: #173b70;
        padding: 10px 18px;
        border-radius: 20px;
