    .button {
        display: inline-block;
        background: #245ba8;
        color: white;
        padding: 12px 24px;
        border-radius: 25px;
        text-decoration: none;
    }

    section {
        padding: 55px 20px;
        max-width: 950px;
        margin: auto;
    }

    section h2 {
        color: #173b70;
        text-align: center;
        margin-bottom: 25px;
        font-size: 28px;
