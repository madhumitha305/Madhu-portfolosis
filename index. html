    .contact {
        text-align: center;
    }

    footer {
        background: #173b70;
        color: white;
        text-align: center;
        padding: 20px;
    }

    @media (max-width: 600px) {
        .hero h2 {
            font-size: 29px;
        }

        nav a {
            display: inline-block;
            margin: 5px;
        }
    }
